# Copy to .env.local here, or run configure.py / configure_openai.py from the repository root.
# Supply your own entitled API keys. Never copy Codex/company credentials.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
OPENAI_LIVE_API_KEY=
OPENAI_LIVE_URL=wss://api.openai.com/v1/live/sessions
# OPENAI_API_KEY is also accepted as a fallback; OPENAI_LIVE_API_KEY takes precedence.
