{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "demo-qingshuai-lab",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/healthz", "/voice-lab", "/voice-lab/"]
  }
}
